    },
    {
      "name": "Icon rail",
      "shell": "icons",
      "why": "More width for the map, but the five areas lose their names"
    },
    {
      "name": "Command bar",
      "shell": "command",
      "why": "Fast for power users who type store numbers, slower for managers who browse"
    }
